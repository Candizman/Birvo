# Administrator authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Use the Supabase secret key (preferred) or the legacy service-role
# key. Required: the player portal, public league links, rate limiting, roster
# import and the scheduled trash purge all run through the service client.
# Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Use at least 32 random bytes for each value; required in production.
PLAYER_SESSION_SECRET=
PUBLIC_LINK_SECRET=

# Public base URL for the application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Guards /api/cron/purge-trash so only the scheduler can trigger it.
# CRON_SECRET=

# Payment integration is not active yet. Do not add live keys.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
