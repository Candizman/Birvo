# Administrator authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Data backend. Keep "sqlite" for local preview only. Production requires
# "supabase" and the cutover gate must remain closed until every runbook check passes.
BIRVO_DATA_BACKEND=sqlite
BIRVO_SUPABASE_CUTOVER_COMPLETE=false

# Server-only. Use the Supabase secret key (preferred) or legacy service-role
# key only in the deployment environment. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Use at least 32 random bytes for each value; required in production.
PLAYER_SESSION_SECRET=
PUBLIC_LINK_SECRET=

# Public base URL for the application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Payment integration is not active yet. Do not add live keys.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
